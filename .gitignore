# Unreal generated
Binaries/
Intermediate/
DerivedDataCache/
Saved/
Build/
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
Plugins/*/Binaries/
Plugins/*/Intermediate/
vendor/*/Binaries/
vendor/*/Intermediate/
vendor/*/Saved/
vendor/*/DerivedDataCache/

# the setup's machine-specific answers
setup/env.json

# Python
__pycache__/
*.pyc

# raw footage stays out of git (keep it on a drive; the takes we use are imported as assets)
Footage/

# Kimodo's environment, its models and caches (setup.py kimodo: 25 GB or so; rebuildable)
vendor/kimodo/
# Blender's Python module for tools/retarget.py (rebuildable)
vendor/blender/
# MediaPipe's environment and the Face Landmarker model (tools/face_mesh.py setup; rebuildable)
vendor/face_mesh/
# DiffLocks (removed 2026-10-22: it needs an account): if the folder is still there, delete it; never shared
vendor/difflocks/
# Perm: its code, environment, checkpoints, fitted hairstyles, the AVATAR NEO head, the library (tools/perm.py setup)
vendor/perm/
# the hair splat's environment (torch, OpenCV, MediaPipe) and models, and its check's output (tools/gshair.py setup)
vendor/gshair/
# a salon reference's working folder (frames, masks, poses before tools/gshair.py reference writes the reference)
Content/Studio/Hair/References/*/capture/
Content/Studio/Hair/References/*/run.log

# generated: package_game.py's copies and builds; the UnrealClaude source checkout (the plugin copy is tracked)
Content/StoryData/
Builds/
vendor/UnrealClaude-src/
Plugins/UnrealClaude/Resources/mcp-bridge/node_modules/

# the project's Python environment (uv venv)
.venv/

# Unreal's generated project files on Linux, and each person's Developers folder
Makefile
*.code-workspace
.vscode/
/.ignore
Content/Developers/
# the scripts UnrealClaude runs (generated; get_script_history and the editor log keep the record)
Content/UnrealClaude/

# Epic's First Person template (its content, maps and C++): Epic's, so never in this public repo (CLAUDE.md, assets).
# A fresh clone makes it again: SETUP.md S2 (the Project Browser, then `setup.py adopt`).
Content/Characters/
Content/FirstPerson/
Content/Input/
Content/LevelPrototyping/
Content/Variant_Horror/
Content/Variant_Shooter/
Content/Weapons/
Content/__ExternalActors__/FirstPerson/
Content/__ExternalActors__/Variant_*/
Content/__ExternalObjects__/FirstPerson/
Content/__ExternalObjects__/Variant_*/
Source/HorrorEngine/

# the kit's meshes: made from the story by `node tools/kit/build.mjs` (the importer runs it), the same every time
Content/Studio/Library/meshes/kit/
Content/Studio/Library/index/kit.json

# meshes of yours (the scene builder's split hinges, anything you add as local/): not CC0, so not shared
Content/Studio/Library/meshes/local/
Content/Studio/Library/index/local.json

# the PBR shelf (docs/ASSETS.md §6): your texture sets in assets/pbr/, a folder each, too big for git: nothing in it is
# tracked (assets/README.md says what goes there); its old place, Content/Studio/PBR, still read, keeps only its README
assets/pbr/
Content/Studio/PBR/*
!Content/Studio/PBR/README.md
# faces from photos (tools/face_mesh.py): made from real people's pictures, they stay on your machine
Content/Studio/Heads/
# the body editor's characters (tools/body/): their face pictures, settings and exports stay on your machine
Content/Studio/People/

# made by the desk's Generate (storykit.generate) from story.json: rebuilt, never edited (CLAUDE.md, "text is the truth")
Content/Games/*/Maps/
Content/Games/*/Previs/preview.json
Content/Games/*/Previs/Body_*.glb
Content/Games/*/Imported/
Content/Studio/Greybox/
Content/Studio/Imported/
# made from text in the editor when it's needed (storykit.people.eye_material: the Studio's eye)
Content/Studio/Materials/M_StudioEye.uasset
# the first imports went to /Game/Studio/Library/Meshes (Unreal's copies, beside the CC0 sources in meshes/)
Content/Studio/Library/Meshes/
# the expression library's face videos (a face, often a real one): the curves (expression.json) are tracked
Content/Studio/Expressions/*/clip.mp4

# the PLAY test's picture of a failing step (tools/director/playtest.js)
playtest_fail.png
testroom_fail.png
exprtest_fail.png
