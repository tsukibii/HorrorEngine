    {"id": "on", "acts": [{"label": "Turn it off", "to": "off"}], "fx": [{"fx": "screen", "mode": "on"}], "sound": [{"sound": "murmur", "level": 0.3}]}
   ]
  },
  "fridge": {
   "label": "a fridge",
   "states": [
    {"id": "on", "sound": [{"sound": "hum", "level": 0.35}]},
    {"id": "off"}
   ]
  }
 }
}
