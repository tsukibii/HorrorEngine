 from .state import ClientSession, ModelBundle
 
 
+def loop_first_pose(session: ClientSession, constraint_info: dict, last_frame: int, device: str) -> dict:
+    """Loop: the earliest Full-Body keyframe again at the last frame, so the motion ends in the pose it starts in.
+
+    The copy moves along the 2D root path (from its point at the first keyframe to its point at the last frame, or
+    its last waypoint before it), and stays in place without a path. A keyframe already at the last frame wins.
+    """
+    frames = [int(f) for f in constraint_info["frame_idx"]]
+    if not frames or last_frame in frames or min(frames) >= last_frame:
+        return constraint_info
+    i = frames.index(min(frames))
+    joints_pos = constraint_info["joints_pos"][i].clone()
+    joints_rot = constraint_info["joints_rot"][i]
+
+    root = session.constraints.get("2D Root")
+    if root is not None and root.keyframes:
+        info = root.get_constraint_info(device=device)
+        path = {int(f): info["root_pos"][k] for k, f in enumerate(info["frame_idx"])}
+        before = [f for f in path if f <= last_frame]
+        if before:
+            start = path.get(frames[i], joints_pos[session.skeleton.root_idx])
+            end = path[max(before)]
+            joints_pos[:, 0] += end[0] - start[0]
+            joints_pos[:, 2] += end[2] - start[2]
+
+    return {
+        **constraint_info,
+        "frame_idx": frames + [last_frame],
+        "joints_pos": torch.cat([constraint_info["joints_pos"], joints_pos[None]], dim=0),
+        "joints_rot": torch.cat([constraint_info["joints_rot"], joints_rot[None]], dim=0),
+    }
+
+
