+++ b/kimodo/demo/studio.py
@@ -0,0 +1,280 @@
+"""HorrorStudio additions to the demo (kept in the studio repo as setup/kimodo_studio.patch).
+
+- Exports: In place (the root's travel taken out, its sway kept, for NPC and player rigs) and Drop last frame (a
+  Loop's last frame repeats its first: drop it so the wrap doesn't hold a frame).
+- Draw Path: click the floor to add root waypoints (click one to remove it), paced into 2D Root keyframes.
+- The pose window: an OpenPose-style figure to pose by dragging (studio_web/), armed so that clicks on the Full-Body
+  track drop it, or dropped at the playhead.
+- The stage: a story's rooms, doors, furniture and marks as see-through boxes, written by the studio's
+  `python tools/kimodo.py stage`, already in Kimodo's axes (x left, y up, z forward, the character starting at the
+  origin) and scaled to the cast member's height.
+"""
+import json
+import math
+import os
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+COLORS = {"floor": (110, 110, 120), "wall": (205, 205, 215), "door": (235, 145, 40), "mesh": (70, 140, 230),
+          "use": (60, 200, 120), "mark": (240, 220, 60), "player": (230, 70, 70)}
+
+
+def travel(root_xz: np.ndarray, fps: float, secs: float = 0.25) -> np.ndarray:
+    """The root's travel without its sway: the path smoothed over `secs`, pinned to the real root at both ends (so an
+    in-place Loop ends exactly where it starts). [T, 2], zero at the first frame."""
+    sigma = max(1.0, secs * fps)
+    r = int(3 * sigma)
+    k = np.exp(-0.5 * (np.arange(-r, r + 1) / sigma) ** 2)
+    k /= k.sum()
+    padded = np.pad(root_xz, ((r, r), (0, 0)), mode="edge")
+    smooth = np.stack([np.convolve(padded[:, a], k, mode="valid") for a in range(2)], axis=1)
+    u = np.linspace(0.0, 1.0, len(root_xz))[:, None]
+    smooth += (root_xz[0] - smooth[0]) * (1 - u) + (root_xz[-1] - smooth[-1]) * u
+    return smooth - smooth[0]
+
+
+def for_export(motion, fps: float, in_place: bool = False, drop_last: bool = False):
+    """The motion as the exporters read it (joints_pos, joints_rot, joints_local_rot, foot_contacts, skeleton)."""
+    if not in_place and not drop_last:
+        return motion
+    pos = motion.joints_pos.detach().clone()
+    rot, local, contacts = motion.joints_rot, motion.joints_local_rot, motion.foot_contacts
+    if in_place:
+        root = pos[:, motion.skeleton.root_idx][:, [0, 2]].cpu().numpy()
+        off = torch.as_tensor(travel(root, fps), dtype=pos.dtype, device=pos.device)
+        pos[:, :, 0] -= off[:, None, 0]
+        pos[:, :, 2] -= off[:, None, 1]
+    if drop_last and pos.shape[0] > 1:
+        pos, rot, local = pos[:-1], rot[:-1], local[:-1]
+        contacts = contacts[:-1] if contacts is not None else None
+    return SimpleNamespace(skeleton=motion.skeleton, joints_pos=pos, joints_rot=rot, joints_local_rot=local,
+                           foot_contacts=contacts)
+
+
+def yaw_wxyz(deg: float):
+    a = math.radians(deg) / 2
+    return (math.cos(a), 0.0, math.sin(a), 0.0)
+
+
+def load_stage(scene, path: str, opacity: float, labels: bool = True) -> dict:
+    """Draws a stage file under /stage; returns the handles for place_stage, set_opacity and clear_stage."""
+    with open(path, encoding="utf-8") as f:
+        data = json.load(f)
+    st = {"frame": scene.add_frame("/stage", show_axes=False), "boxes": [], "labels": [], "data": data}
+    for b in data.get("boxes", []):
+        alpha = float(b.get("alpha", 1.0))
+        h = scene.add_box(f"/stage/{b['id']}", color=tuple(COLORS.get(b.get("kind"), (180, 180, 180))),
+                          dimensions=tuple(b["size"]), position=tuple(b["center"]), wxyz=yaw_wxyz(b.get("yaw", 0.0)),
+                          opacity=min(1.0, opacity * alpha), side="double", cast_shadow=False, receive_shadow=False)
+        st["boxes"].append((h, alpha))
+        if b.get("label"):
+            top = (b["center"][0], b["center"][1] + b["size"][1] / 2 + 0.05, b["center"][2])
+            st["labels"].append(scene.add_label(f"/stage/{b['id']}_label", text=b["label"], position=top,
+                                                font_size_mode="screen", font_screen_scale=0.6, visible=labels))
+    for m in data.get("marks", []):
+        kind = m.get("kind", "mark")
+        x, y, z = m["pos"]
+        h = scene.add_box(f"/stage/mark_{m['id']}", color=COLORS[kind], dimensions=(0.06, 0.01, 0.4),
+                          position=(x + 0.2 * math.sin(math.radians(m["yaw"])), y + 0.005,
+                                    z + 0.2 * math.cos(math.radians(m["yaw"]))),
+                          wxyz=yaw_wxyz(m["yaw"]), cast_shadow=False, receive_shadow=False)
+        st["boxes"].append((h, None))
+        if m.get("eye"):
+            st["boxes"].append((scene.add_icosphere(f"/stage/eye_{m['id']}", radius=0.06, color=COLORS[kind],
+                                                    position=(x, m["eye"], z), cast_shadow=False), None))
+        st["labels"].append(scene.add_label(f"/stage/mark_{m['id']}_label", text=m["id"], position=(x, y + 0.08, z),
+                                            font_size_mode="screen", font_screen_scale=0.5, visible=labels))
+    return st
+
+
+def place_stage(st: dict, x: float, z: float, turn: float) -> None:
+    st["frame"].position = (x, 0.0, z)
+    st["frame"].wxyz = yaw_wxyz(turn)
+
+
+def set_opacity(st: dict, opacity: float) -> None:
+    for h, alpha in st["boxes"]:
+        if alpha is not None:
+            h.opacity = min(1.0, opacity * alpha)
+
+
+def set_labels(st: dict, visible: bool) -> None:
+    for h in st["labels"]:
+        h.visible = visible
+
+
+def clear_stage(st: dict) -> None:
+    for h, _ in st["boxes"]:
+        h.remove()
+    for h in st["labels"]:
+        h.remove()
+    st["frame"].remove()
+    st.clear()
+
+
+# --- Draw Path: waypoints clicked on the floor, paced into 2D Root keyframes ---------------------------------------
+
+PACES = {"Even over clip": None, "Sneak (0.8 m/s)": 0.8, "Walk (1.4 m/s)": 1.4, "Jog (2.5 m/s)": 2.5, "Run (3.5 m/s)": 3.5}
+
+
+def floor_hit(ray_origin, ray_direction):
+    """Where a click's ray meets the floor (y = 0), as [x, z], or None if it looks up."""
+    o, d = np.asarray(ray_origin, float), np.asarray(ray_direction, float)
+    if d[1] > -1e-6:
+        return None
+    p = o + d * (-o[1] / d[1])
+    return [float(p[0]), float(p[2])]
+
+
+def pace_frames(points, pace, fps, last_frame):
+    """A frame for each waypoint (the first is the start, frame 0): by distance at the pace's speed, or spread over
+    the clip. Frames only increase, and stop at the clip's last frame (`over` says the path was longer)."""
+    pts = np.asarray(points, float)
+    if len(pts) < 2:
+        return [0] * len(pts), False
+    cum = np.concatenate([[0.0], np.cumsum(np.linalg.norm(np.diff(pts, axis=0), axis=1))])
+    speed = PACES.get(pace)
+    raw = cum / cum[-1] * last_frame if speed is None or cum[-1] == 0 else cum / speed * fps
+    frames, over = [], bool(raw[-1] > last_frame + 0.5)
+    for f in raw:
+        f = int(round(min(f, last_frame)))
+        frames.append(max(f, frames[-1] + 1) if frames else 0)
+    return frames, over or frames[-1] > last_frame
+
+
+# --- The pose window: an OpenPose-style figure in its own page, talking to the demo over a small local server -------
+
+def effective_locals(global_rots: np.ndarray, parents) -> np.ndarray:
+    """Each joint's rotation relative to its parent's global one (the root's is its global): FK with these and the
+    skeleton's neutral offsets gives back the same pose, whatever rest rotations the skeleton bakes in."""
+    return np.stack([global_rots[j] if parents[j] < 0 else global_rots[parents[j]].T @ global_rots[j]
+                     for j in range(len(parents))])
+
+
+def pose_fk(local_rots: np.ndarray, root_pos, parents, offsets):
+    """Global rotations [J, 3, 3] and positions [J, 3] from effective local rotations."""
+    J = len(parents)
+    G, P = np.zeros((J, 3, 3), np.float32), np.zeros((J, 3), np.float32)
+    for j in range(J):
+        p = parents[j]
+        if p < 0:
+            G[j], P[j] = local_rots[j], root_pos
+        else:
+            G[j], P[j] = G[p] @ local_rots[j], P[p] + G[p] @ offsets[j]
+    return G, P
+
+
+def skeleton_layout(skeleton):
+    """What the pose page needs to draw and pose the skeleton: names, parents, offsets from the parent."""
+    parents = [int(p) for p in skeleton.joint_parents.tolist()]
+    n = skeleton.neutral_joints.detach().cpu().numpy()
+    off = n - n[[max(p, 0) for p in parents]]
+    off[[j for j, p in enumerate(parents) if p < 0]] = 0
+    from kimodo.skeleton.kinematics import fk
+    dev = skeleton.neutral_joints.device
+    eye = torch.eye(3, device=dev).repeat(1, len(parents), 1, 1)
+    rest = fk(eye, torch.zeros(1, 3, device=dev), skeleton)[0][0].cpu().numpy()   # the rest pose's global rotations (for Mirror)
+    return {"names": list(skeleton.bone_order_names), "parents": parents, "offsets": off.round(5).tolist(),
+            "rest_quats": rots_to_quats(rest)}
+
+
+def rots_to_quats(R: np.ndarray) -> list:
+    from scipy.spatial.transform import Rotation
+    return Rotation.from_matrix(np.asarray(R, float)).as_quat().round(6).tolist()      # x, y, z, w
+
+
+def quats_to_rots(q) -> np.ndarray:
+    from scipy.spatial.transform import Rotation
+    return Rotation.from_quat(np.asarray(q, float)).as_matrix().astype(np.float32)
+
+
+class PoseBridge:
+    """A local HTTP server for the pose window (an iframe in a modal): the page and three.js, and per browser tab
+    (viser client) the hooks `layout()`, `frame()`, `arm(pose)` and `drop(pose)` registered by the UI."""
+
+    def __init__(self, port: int):
+        import threading
+        from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+        from pathlib import Path
+
+        self.port, self.hooks = port, {}
+        web = Path(__file__).resolve().parent / "studio_web"
+        three = [Path(p) for p in (os.environ.get("KIMODO_THREE_DIR"),) if p]
+        three.append(Path(viser_client_dir()) / "node_modules" / "three" / "build")
+        bridge = self
+
+        class Handler(BaseHTTPRequestHandler):
+            def log_message(self, *a):
+                pass
+
+            def reply(self, code, body, ctype="application/json"):
+                data = body if isinstance(body, bytes) else json.dumps(body).encode()
+                self.send_response(code)
+                self.send_header("Content-Type", ctype)
+                self.send_header("Content-Length", str(len(data)))
+                self.send_header("Cache-Control", "no-store")
+                self.end_headers()
+                self.wfile.write(data)
+
+            def route(self):
+                from urllib.parse import parse_qs, urlparse
+                u = urlparse(self.path)
+                q = {k: v[0] for k, v in parse_qs(u.query).items()}
+                return u.path.strip("/"), bridge.hooks.get(q.get("c", ""))
+
+            def do_GET(self):
+                path, hooks = self.route()
+                if path in ("pose.html", "pose.js"):
+                    f = web / path
+                    return self.reply(200, f.read_bytes(), "text/html" if path.endswith("html") else "text/javascript")
+                if path == "three.module.min.js":
+                    for d in three:
+                        for name in ("three.module.min.js", "three.module.js"):
+                            if (d / name).exists():
+                                return self.reply(200, (d / name).read_bytes(), "text/javascript")
+                    return self.reply(404, {"error": "three.js not found (set KIMODO_THREE_DIR)"})
+                if hooks is None:
+                    return self.reply(404, {"error": "this demo tab is gone: reopen the pose window"})
+                if path in ("api/layout", "api/frame"):
+                    try:
+                        return self.reply(200, hooks[path[4:]]())
+                    except Exception as e:
+                        import traceback
+                        traceback.print_exc()
+                        return self.reply(409, {"error": str(e)})
+                self.reply(404, {"error": path})
+
+            def do_POST(self):
+                path, hooks = self.route()
+                if hooks is None:
+                    return self.reply(404, {"error": "this demo tab is gone: reopen the pose window"})
+                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
+                if path in ("api/arm", "api/drop"):
+                    try:
+                        return self.reply(200, {"ok": True, "message": hooks[path[4:]](body)})
+                    except Exception as e:
+                        return self.reply(400, {"ok": False, "message": str(e)})
+                self.reply(404, {"error": path})
+
+        self.server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
+        threading.Thread(target=self.server.serve_forever, daemon=True).start()
+
+    def url(self, client_id) -> str:
+        return f"http://127.0.0.1:{self.port}/pose.html?c={client_id}"
+
+
+def viser_client_dir() -> str:
+    import viser
+    return os.path.join(os.path.dirname(viser.__file__), "client")
+
+
+_bridge = None
+
+
+def pose_bridge() -> PoseBridge:
+    global _bridge
+    if _bridge is None:
+        _bridge = PoseBridge(int(os.environ.get("KIMODO_POSE_PORT", "7861")))
+    return _bridge
