+    const geo = new THREE.BoxGeometry(...b.size), col = KIND[b.kind] ?? 0xb4b4b4;
+    const m = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: b.kind === "floor" ? 0.05 : 0.09, depthWrite: false }));
