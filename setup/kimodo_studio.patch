+// The pose window: an OpenPose-style figure over Kimodo's full skeleton. Dots are handles: hands and feet move with
+// two-bone IK (elbows and knees steer the bend), the hips move the body (feet pinned or not), the neck bends the spine,
+// the top of the head tilts the neck. Rotations are kept relative to each parent's global one, so the pose goes back
+// to the demo exactly (studio.py: effective_locals, pose_fk).
+import * as THREE from "./three.module.min.js";
+
+const C = new URLSearchParams(location.search).get("c");
+const api = (path, body) => fetch(`${path}?c=${C}`, body === undefined ? {} : {
+  method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }).then((r) => r.json());
+
+const L = await api("api/layout");
+const N = L.names, PAR = L.parents, J = N.length, ix = Object.fromEntries(N.map((n, i) => [n, i]));
+const OFF = L.offsets.map((o) => new THREE.Vector3(...o));
+const REST = L.rest_quats.map((q) => new THREE.Quaternion(...q));
+const ROOT = PAR.indexOf(-1);
+
+// OpenPose's 18 limb colours, on Kimodo's joints
+const OP = [[255, 0, 0], [255, 85, 0], [255, 170, 0], [255, 255, 0], [170, 255, 0], [85, 255, 0], [0, 255, 0], [0, 255, 85],
