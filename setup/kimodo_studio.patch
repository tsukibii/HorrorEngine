diff --git i/kimodo/demo/studio.py w/kimodo/demo/studio.py
new file mode 100644
index 0000000..7b7c578
--- /dev/null
+++ w/kimodo/demo/studio.py
@@ -0,0 +1,110 @@
+"""HorrorStudio additions to the demo (kept in the studio repo as setup/kimodo_studio.patch).
+
+- Exports: In place (the root's travel taken out, its sway kept, for NPC and player rigs) and Drop last frame (a
+  Loop's last frame repeats its first: drop it so the wrap doesn't hold a frame).
+- The stage: a story's rooms, doors, furniture and marks as see-through boxes, written by the studio's
+  `python tools/kimodo.py stage`, already in Kimodo's axes (x left, y up, z forward, the character starting at the
+  origin) and scaled to the cast member's height.
+"""
+import json
+import math
+from types import SimpleNamespace
+
+import numpy as np
+import torch
+
+COLORS = {"floor": (110, 110, 120), "wall": (205, 205, 215), "door": (235, 145, 40), "mesh": (70, 140, 230),
+          "use": (60, 200, 120), "mark": (240, 220, 60), "player": (230, 70, 70)}
+
+
+def travel(root_xz: np.ndarray, fps: float, secs: float = 0.25) -> np.ndarray:
+    """The root's travel without its sway: the path smoothed over `secs`, pinned to the real root at both ends (so an
+    in-place Loop ends exactly where it starts). [T, 2], zero at the first frame."""
+    sigma = max(1.0, secs * fps)
+    r = int(3 * sigma)
+    k = np.exp(-0.5 * (np.arange(-r, r + 1) / sigma) ** 2)
+    k /= k.sum()
+    padded = np.pad(root_xz, ((r, r), (0, 0)), mode="edge")
+    smooth = np.stack([np.convolve(padded[:, a], k, mode="valid") for a in range(2)], axis=1)
+    u = np.linspace(0.0, 1.0, len(root_xz))[:, None]
+    smooth += (root_xz[0] - smooth[0]) * (1 - u) + (root_xz[-1] - smooth[-1]) * u
+    return smooth - smooth[0]
+
+
+def for_export(motion, fps: float, in_place: bool = False, drop_last: bool = False):
+    """The motion as the exporters read it (joints_pos, joints_rot, joints_local_rot, foot_contacts, skeleton)."""
+    if not in_place and not drop_last:
+        return motion
+    pos = motion.joints_pos.detach().clone()
+    rot, local, contacts = motion.joints_rot, motion.joints_local_rot, motion.foot_contacts
+    if in_place:
+        root = pos[:, motion.skeleton.root_idx][:, [0, 2]].cpu().numpy()
+        off = torch.as_tensor(travel(root, fps), dtype=pos.dtype, device=pos.device)
+        pos[:, :, 0] -= off[:, None, 0]
+        pos[:, :, 2] -= off[:, None, 1]
+    if drop_last and pos.shape[0] > 1:
+        pos, rot, local = pos[:-1], rot[:-1], local[:-1]
+        contacts = contacts[:-1] if contacts is not None else None
+    return SimpleNamespace(skeleton=motion.skeleton, joints_pos=pos, joints_rot=rot, joints_local_rot=local,
+                           foot_contacts=contacts)
+
+
+def yaw_wxyz(deg: float):
+    a = math.radians(deg) / 2
+    return (math.cos(a), 0.0, math.sin(a), 0.0)
+
+
+def load_stage(scene, path: str, opacity: float, labels: bool = True) -> dict:
+    """Draws a stage file under /stage; returns the handles for place_stage, set_opacity and clear_stage."""
+    with open(path, encoding="utf-8") as f:
+        data = json.load(f)
+    st = {"frame": scene.add_frame("/stage", show_axes=False), "boxes": [], "labels": [], "data": data}
+    for b in data.get("boxes", []):
+        alpha = float(b.get("alpha", 1.0))
+        h = scene.add_box(f"/stage/{b['id']}", color=tuple(COLORS.get(b.get("kind"), (180, 180, 180))),
+                          dimensions=tuple(b["size"]), position=tuple(b["center"]), wxyz=yaw_wxyz(b.get("yaw", 0.0)),
+                          opacity=min(1.0, opacity * alpha), side="double", cast_shadow=False, receive_shadow=False)
+        st["boxes"].append((h, alpha))
+        if b.get("label"):
+            top = (b["center"][0], b["center"][1] + b["size"][1] / 2 + 0.05, b["center"][2])
+            st["labels"].append(scene.add_label(f"/stage/{b['id']}_label", text=b["label"], position=top,
+                                                font_size_mode="screen", font_screen_scale=0.6, visible=labels))
+    for m in data.get("marks", []):
+        kind = m.get("kind", "mark")
+        x, y, z = m["pos"]
+        h = scene.add_box(f"/stage/mark_{m['id']}", color=COLORS[kind], dimensions=(0.06, 0.01, 0.4),
+                          position=(x + 0.2 * math.sin(math.radians(m["yaw"])), y + 0.005,
+                                    z + 0.2 * math.cos(math.radians(m["yaw"]))),
+                          wxyz=yaw_wxyz(m["yaw"]), cast_shadow=False, receive_shadow=False)
+        st["boxes"].append((h, None))
+        if m.get("eye"):
+            st["boxes"].append((scene.add_icosphere(f"/stage/eye_{m['id']}", radius=0.06, color=COLORS[kind],
+                                                    position=(x, m["eye"], z), cast_shadow=False), None))
+        st["labels"].append(scene.add_label(f"/stage/mark_{m['id']}_label", text=m["id"], position=(x, y + 0.08, z),
+                                            font_size_mode="screen", font_screen_scale=0.5, visible=labels))
+    return st
+
+
+def place_stage(st: dict, x: float, z: float, turn: float) -> None:
+    st["frame"].position = (x, 0.0, z)
+    st["frame"].wxyz = yaw_wxyz(turn)
+
+
+def set_opacity(st: dict, opacity: float) -> None:
+    for h, alpha in st["boxes"]:
+        if alpha is not None:
+            h.opacity = min(1.0, opacity * alpha)
+
+
+def set_labels(st: dict, visible: bool) -> None:
+    for h in st["labels"]:
+        h.visible = visible
+
+
+def clear_stage(st: dict) -> None:
+    for h, _ in st["boxes"]:
+        h.remove()
+    for h in st["labels"]:
+        h.remove()
+    st["frame"].remove()
+    st.clear()
