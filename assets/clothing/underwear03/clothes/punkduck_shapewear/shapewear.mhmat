# Material definition for shapewear

name shapewear
description Shapewear material
ambientColor 0.498039215686 0.498039215686 0.498039215686
diffuseColor 1.0 1.0 1.0
specularColor 0.356862745098 0.356862745098 0.356862745098
shininess 0.7
emissiveColor 0.0 0.0 0.0
opacity 1.0
translucency 0.0

shadeless False
wireframe False
transparent False
alphaToCoverage True
backfaceCull False
depthless False

castShadows True

receiveShadows True

diffuseTexture shapewear.png
normalmapTexture shapewear_normal.png
normalmapIntensity 1.0

shader shaders/glsl/litsphere

shaderParam litsphereTexture litspheres/lit_leather.png

shaderConfig ambientOcclusion True
shaderConfig normal True
shaderConfig bump False
shaderConfig displacement False
shaderConfig vertexColors False
shaderConfig spec False
shaderConfig transparency True
shaderConfig diffuse True
